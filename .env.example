# Copy to .env.local. Never commit real secrets.
SITE_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DB=My_portfolio
# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
ADMIN_TOKEN=
RESEND_API_KEY=
# Use a sender on your verified Resend domain
EMAIL_FROM=
CONTACT_EMAIL=
# Optional GitHub API token to increase the statistics API rate limit
GITHUB_TOKEN=
